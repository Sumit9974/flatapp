# FlatApp environment. Copy this file to `.env.local` (git-ignored) and fill in the values:
#   Copy-Item .env.example .env.local
# Expo reads .env.local when it bundles the app, so rebuild the APK after changing it.
#
# Both values come from Supabase -> your project -> Project settings -> API keys / Data API.
# They are built into the APK, which is fine: everything is protected by row-level security
# (supabase/migrations). NEVER put the secret key (sb_secret_...) or the service_role key here.

# Project URL, for example https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Not in this file, on purpose:
# - google-services.json (Firebase config for push) goes in the project root, also git-ignored.
# - FCM_SERVICE_ACCOUNT_B64 (the Firebase service-account key) is a Supabase Edge Function secret,
#   set with `npx supabase secrets set` (see README, "Phone push notifications").
# - push_webhook_secret lives in Supabase Vault; the database creates it, nothing to set.
